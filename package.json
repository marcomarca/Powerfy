{
  "name": "powerfy",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "start": "bun run build && bunx electron apps/desktop",
    "dev": "bun run build && bunx electron apps/desktop",
    "build": "bun run build:native && bun --filter \"*\" build",
    "test": "bun test",
    "test:native": "node scripts/test-native.js",
    "build:native": "node scripts/build-native.js",
    "lint": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "typecheck": "bun --filter \"*\" typecheck",
    "package": "bun run build && bun run --cwd apps/desktop package"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
